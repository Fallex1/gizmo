<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F4F6" android:padding="16dp" android:gravity="center_horizontal">
    <TextView android:id="@+id/deckName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:paddingBottom="4dp" />
    <TextView android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:paddingBottom="12dp" />
    <TextView android:id="@+id/cardText" android:layout_width="match_parent" android:layout_height="220dp" android:gravity="center" android:textSize="20sp" android:background="#FFFFFF" android:padding="16dp" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp">
        <Button android:id="@+id/flip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Flip" />
        <Button android:id="@+id/known" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Known" />
        <Button android:id="@+id/next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Next" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp">
        <Button android:id="@+id/addCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Add Card" />
        <Button android:id="@+id/shuffle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Shuffle" />
    </LinearLayout>
</LinearLayout>
