<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F4F6" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add Card" android:textSize="20sp" android:textStyle="bold" android:paddingBottom="12dp" />
    <EditText android:id="@+id/front" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Front (question)" android:padding="10dp" />
    <EditText android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Back (answer)" android:padding="10dp" android:layout_marginTop="8dp" />
    <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save" android:layout_marginTop="12dp" />
</LinearLayout>
